while getopts ":uvpma:s:j:r" opt; do
    case $opt in
        u) updatepif=true;;
		v) SPOOF_VENDING_SDK=true;;
		p) SPOOF_PROVIDER=true;;
		j) json "$OPTARG";;
        m) manually;;
        a) autofetchtype="$OPTARG";;
        s) OPT_API="$OPTARG";;
        r) NORKP=true;;
        \?) usage;;
