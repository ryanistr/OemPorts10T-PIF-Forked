keybox_xml=$(ls *.xml 2>/dev/null | head -n1)

load_keybox() {
	# $1 = keybox xml path. The ROM-side dex reads @array/keybox according to
	# @string/keybox_type: "ec_rsa" (EC priv + N certs, then RSA priv + N certs),
	# "ec" (EC only), or "rsa" (RSA only). Evoker's live keyboxes are ECDSA-only
	# with a hardware chain, so emit those as type "ec" instead of discarding
	# them and falling back to the AOSP test certs.
	local file=$1
	local ec_keys rsa_keys ec_certs rsa_certs
	ec_keys=$(xmllint --xpath "count(//Key[@algorithm='ecdsa'])" "$file" 2>/dev/null)
	rsa_keys=$(xmllint --xpath "count(//Key[@algorithm='rsa'])" "$file" 2>/dev/null)
	ec_certs=$(xmllint --xpath "count((//Key[@algorithm='ecdsa'])[1]/CertificateChain/Certificate)" "$file" 2>/dev/null)
	rsa_certs=$(xmllint --xpath "count((//Key[@algorithm='rsa'])[1]/CertificateChain/Certificate)" "$file" 2>/dev/null)

	# EC-only keybox (evoker /key): 1 EC key, no RSA key, 2-4 certs.
	if [ "$ec_keys" = "1" ] && [ "$rsa_keys" = "0" ]; then
		case "$ec_certs" in
			2|3|4) ;;
			*) echo "keybox: EC cert chain length $ec_certs not supported (need 2-4) - falling back to AOSP test certs"; return 1 ;;
		esac
		EC_PRIV_KEY=$(xmllint --xpath "//Key[@algorithm='ecdsa']/PrivateKey/text()" "$file")
		eval "EC_CERT_1=\$(xmllint --xpath \"(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[1]/text()\" \"$file\" 2>/dev/null)"
		eval "EC_CERT_2=\$(xmllint --xpath \"(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[2]/text()\" \"$file\" 2>/dev/null)"
		eval "EC_CERT_3=\$(xmllint --xpath \"(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[3]/text()\" \"$file\" 2>/dev/null)"
		eval "EC_CERT_4=\$(xmllint --xpath \"(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[4]/text()\" \"$file\" 2>/dev/null)"
		KEYBOX_TYPE="ec"
		KeyboxSize=$((1 + ec_certs))
		return 0
	fi

	# Dual keybox: EC(priv + N certs) then RSA(priv + N certs), matched chains.
	if [ "$ec_keys" != "1" ] || [ "$rsa_keys" != "1" ] || [ "$ec_certs" != "$rsa_certs" ]; then
		echo "keybox: unusable layout (ecdsa keys=$ec_keys certs=$ec_certs, rsa keys=$rsa_keys certs=$rsa_certs) - falling back to AOSP test certs"
		return 1
	fi
	case "$ec_certs" in
		2|3|4) ;;
		*) echo "keybox: cert chain length $ec_certs not supported (need 2-4) - falling back to AOSP test certs"; return 1 ;;
	esac

	EC_PRIV_KEY=$(xmllint --xpath "//Key[@algorithm='ecdsa']/PrivateKey/text()" "$file")
	RSA_PRIV_KEY=$(xmllint --xpath "//Key[@algorithm='rsa']/PrivateKey/text()" "$file")
	eval "EC_CERT_1=\$(xmllint --xpath \"(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[1]/text()\" \"$file\")"
	eval "EC_CERT_2=\$(xmllint --xpath \"(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[2]/text()\" \"$file\")"
	eval "EC_CERT_3=\$(xmllint --xpath \"(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[3]/text()\" \"$file\")"
	eval "EC_CERT_4=\$(xmllint --xpath \"(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[4]/text()\" \"$file\")"
	eval "RSA_CERT_1=\$(xmllint --xpath \"(//Key[@algorithm='rsa']/CertificateChain/Certificate)[1]/text()\" \"$file\")"
	eval "RSA_CERT_2=\$(xmllint --xpath \"(//Key[@algorithm='rsa']/CertificateChain/Certificate)[2]/text()\" \"$file\")"
	eval "RSA_CERT_3=\$(xmllint --xpath \"(//Key[@algorithm='rsa']/CertificateChain/Certificate)[3]/text()\" \"$file\")"
	eval "RSA_CERT_4=\$(xmllint --xpath \"(//Key[@algorithm='rsa']/CertificateChain/Certificate)[4]/text()\" \"$file\")"
	KEYBOX_TYPE="ec_rsa"
	# 2 private keys + 2*N certs
	KeyboxSize=$((2 + 2 * ec_certs))
	return 0
}

