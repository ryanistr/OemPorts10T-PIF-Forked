json_get() {
	# $1 = json file, $2 = key. Tolerates the key being the last entry (no trailing comma).
	grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$1" | head -n1 | sed 's/.*:[[:space:]]*"\(.*\)"$/\1/'
}

json() {
	json_file=$1
	if [[ $json_file == "" ]]; then
	   echo "usage: $0 -j (json file)"
	   exit 1
	fi
	if [[ ! -f $json_file ]]; then
	   echo "error: json file not found: $json_file"
	   exit 1
	fi

	MODEL=$(json_get "$json_file" MODEL)
	DEVICE=$(json_get "$json_file" DEVICE)
	PRODUCT=$(json_get "$json_file" PRODUCT)
	BRAND=$(json_get "$json_file" BRAND)
	MANUFACTURER=$(json_get "$json_file" MANUFACTURER)
	FINGERPRINT=$(json_get "$json_file" FINGERPRINT)
	RELEASE=$(json_get "$json_file" RELEASE)
	ID=$(json_get "$json_file" ID)
	INCREMENTAL=$(json_get "$json_file" INCREMENTAL)
	TYPE=$(json_get "$json_file" TYPE)
	TAGS=$(json_get "$json_file" TAGS)
	SECURITY_PATCH=$(json_get "$json_file" SECURITY_PATCH)
	JSON_API=$(json_get "$json_file" FIRST_API_LEVEL)

	# The json usually carries only brand/product/device/model/fingerprint. Derive the
	# rest from the fingerprint itself: brand/product/device:release/id/incremental:type/tags
	if [[ -n "$FINGERPRINT" && ( -z "$RELEASE" || -z "$ID" || -z "$INCREMENTAL" || -z "$TYPE" || -z "$TAGS" ) ]]; then
		rest="${FINGERPRINT#*:}"
		rel_id_inc="${rest%%:*}"
		type_tags="${rest#*:}"
		[[ -z "$RELEASE" ]] && RELEASE="${rel_id_inc%%/*}"
		[[ -z "$ID" ]] && ID="$(echo "$rel_id_inc" | cut -d/ -f2)"
		[[ -z "$INCREMENTAL" ]] && INCREMENTAL="$(echo "$rel_id_inc" | cut -d/ -f3)"
		[[ -z "$TYPE" ]] && TYPE="${type_tags%%/*}"
		[[ -z "$TAGS" ]] && TAGS="${type_tags#*/}"
	fi
}

usage() {
    echo "A tool to automatically generate PIF.apk and JSON"
    echo "by Danda420"
    echo ""
    echo "Usage: $0 [-j|-m|-a] -s [first api level] -v -u"
    echo "  -a [ad|xeu]    fetches build properties from android developers or xiaomieu"
    echo "  -j [json file] fetches build properties from supplied pif.json"
    echo "  -m             manually input build properties"
    echo "  -s [api_level] first api level (fallback only; the json's FIRST_API_LEVEL wins)"
    echo "  -v             enable spoof vending sdk to 32"
    echo "  -p             enable spoof provider"
    echo "  -r             no RKP keybox: use the AOSP test certs instead"
    echo "  -u             updates server pif"
    exit 1
}

if [[ $# -eq 0 ]]; then
